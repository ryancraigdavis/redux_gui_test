{
  "name": "redux_gui_test",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "26" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false },
    "ghcr.io/reduxisu/features/rbs:1": {}
  },
  "appPort": [3000],
  "portsAttributes": {
    "3000": { "label": "redux_gui_test", "onAutoForward": "notify" }
  },
  "mounts": [
    "source=redux_gui_test-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "postStartCommand": "if [ \"$(stat -c %U /workspaces/redux_gui_test)\" != \"vscode\" ]; then sudo chown -R vscode:vscode /workspaces/redux_gui_test; fi",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "biomejs.biome"]
    }
  }
}
